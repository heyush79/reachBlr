# Copy to .env and fill in. Never commit .env.

# Port for "docker compose up" (http://localhost:APP_PORT). Change it if 8080 is taken.
APP_PORT=8080

# Google Places API (New) key. Restrict it to "Places API (New)" and set a daily quota in Google Cloud Console.
# Leave empty to turn the "Nearby on Google" feature off.
GOOGLE_PLACES_API_KEY=

# Rate limits for /api/places/nearby
PLACES_PER_IP_PER_MINUTE=10
PLACES_GLOBAL_PER_DAY=500

# Browser origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
